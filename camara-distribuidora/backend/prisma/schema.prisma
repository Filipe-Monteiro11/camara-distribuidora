generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String   @id @default(uuid())
  nome         String
  descricao    String?
  categoria    String?
  imagem       String?
  maisVendido  Boolean  @default(false)
  maisProcurado Boolean  @default(false)
  prioridade   Int      @default(0)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Gallery {
  id           String   @id @default(uuid())
  titulo       String
  descricao    String?
  categoria    String?
  tipo         String   @default("imagem")
  imagem       String?
  videoUrl     String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  senhaHash String
  criadoEm  DateTime @default(now())
}

model Recipe {
  id           String   @id @default(uuid())
  titulo       String
  descricao    String?
  imagem       String?
  ingredientes String[]
  preparo      String
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Curriculo {
  id           String   @id @default(uuid())
  nome         String
  email        String
  telefone     String
  area         String?
  mensagem     String?
  arquivo      String
  nomeArquivo  String
  status       String   @default("novo")
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([criadoEm])
  @@index([status])
}